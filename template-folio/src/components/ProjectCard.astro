---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';
import site from '../data/site.json';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  lang?: Lang;
  presentation?: 'editorial' | 'gallery';
}

const { project, index, lang = 'en', presentation = 'editorial' } = Astro.props;
const { data } = project;
const title = lang === 'fr' ? data.frTitle ?? data.title : data.title;
const role = lang === 'fr' ? data.frRole ?? data.role : data.role;
const summary = lang === 'fr' ? data.frSummary ?? data.summary : data.summary;
const coverVariant = (index % 3) + 1;
const motif = (site as { motif?: string }).motif ?? 'cercles';
const motifClass = motif === 'cercles' ? '' : ` project-art--motif-${motif}`;
const base = import.meta.env.BASE_URL;
const imageSrc = data.keyArt ? `${base}${data.keyArt.replace(/^\/+/, '')}` : undefined;
const showGeneratedArtwork = presentation === 'gallery' && !imageSrc;
---

<article class:list={['project-card', `project-card--${presentation}`, !imageSrc && !showGeneratedArtwork && 'project-card--text-only']}>
  {(imageSrc || showGeneratedArtwork) && <div class="project-card__visual">
    {imageSrc ? (
      <img class="project-art h-full w-full object-cover" src={imageSrc} alt={data.keyArtAlt ?? title} loading="lazy" decoding="async" />
    ) : (
      <div class={`project-art project-art--${coverVariant}${motifClass}`} aria-hidden="true">
        <span class="project-art__index">{String(index + 1).padStart(2, '0')}</span>
        <span class="project-art__title">{title}</span>
      </div>
    )}
  </div>}
  <div class="project-card__content">
    <div class="project-meta"><span>{role}</span><span>{data.years}</span></div>
    <h3 class="project-title">{title}</h3>
    <p class="project-summary">{summary}</p>
    {data.links.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
        {data.links.map((link) => <a class="text-sm font-semibold text-brand underline-offset-4 hover:underline" href={link.url}>{link.label}</a>)}
      </div>
    )}
  </div>
</article>
