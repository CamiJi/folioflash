---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import site from '../data/site.json';
import { t } from '../i18n/ui';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .slice(0, 6);
const presentation = (site as unknown as { projectPresentation?: string }).projectPresentation === 'gallery' ? 'gallery' : 'editorial';
const route = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\/+/, '')}`;
---

<Base title={`${site.name} — ${site.craft}`} description={site.tagline} lang="en">
  <section class="grid items-end gap-10 border-b border-rule pb-14 md:grid-cols-[1.2fr_0.8fr] md:gap-16 md:pb-24">
    <div>
      <p class="eyebrow">{site.craft}</p>
      <h1 class="hero-title">{site.name}</h1>
    </div>
    <div class="hero-copy">
      <p class="hero-tagline">{site.tagline}</p>
      <p class="hero-bio">{site.bio}</p>
      {site.email && !site.email.endsWith('example.com') && <a class="text-link" href={route('contact/')}>{t('en', 'emailMe')} <span aria-hidden="true">↗</span></a>}
    </div>
  </section>

  {projects.length > 0 && <section class="pt-14 md:pt-20" aria-labelledby="selected-work">
    <div class="section-heading mb-8 md:mb-10">
      <h2 id="selected-work">{t('en', 'featured')}</h2>
      <p>{projects.length} {projects.length === 1 ? 'project' : 'projects'}</p>
    </div>
    <div class:list={['project-grid', presentation === 'editorial' && 'project-grid--editorial']}>
      {projects.map((project, index) => <ProjectCard project={project} index={index} presentation={presentation} />)}
    </div>
    <a class="text-link mt-10" href={route('work/')}>{t('en', 'allProjects')} <span aria-hidden="true">↗</span></a>
  </section>}
</Base>
