---
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';
import { t } from '../../i18n/ui';
const fr = (site as unknown as { fr: { tagline: string; bio: string } }).fr;
const route = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\/+/, '')}`;
---

<Base title={`${t('fr', 'about')} — ${site.name}`} description={fr.bio} lang="fr">
  <article class="grid gap-10 md:grid-cols-[0.6fr_1fr] md:gap-20">
    <div>
      <p class="eyebrow mb-5">{site.craft}</p>
      <h1 class="page-title">{t('fr', 'about')}</h1>
    </div>
    <div class="max-w-2xl">
      <p class="font-display text-3xl leading-tight tracking-tight md:text-5xl">{fr.tagline}</p>
      <p class="mt-6 text-lg leading-relaxed text-muted">{fr.bio}</p>
      <a class="text-link" href={route('fr/contact/')}>{t('fr', 'emailMe')} <span aria-hidden="true">↗</span></a>
    </div>
  </article>
</Base>
