---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import site from '../data/site.json';
import { t } from '../i18n/ui';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999),
);
const presentation = (site as unknown as { projectPresentation?: string }).projectPresentation === 'gallery' ? 'gallery' : 'editorial';
---

<Base title={`${t('en', 'allProjects')} — ${site.name}`} description={site.tagline} lang="en">
  <header class="mb-12 max-w-3xl md:mb-16">
    <p class="eyebrow mb-5">{site.craft}</p>
    <h1 class="page-title">{t('en', 'allProjects')}</h1>
    <p class="mt-4 max-w-xl text-base text-muted">{site.tagline}</p>
  </header>
  {projects.length > 0 ? <div class:list={['project-grid', presentation === 'editorial' && 'project-grid--editorial']}>
    {projects.map((project, index) => <ProjectCard project={project} index={index} presentation={presentation} />)}
  </div> : <p class="max-w-xl text-muted">This portfolio does not include projects to show yet. You can read more about {site.name} on the about page.</p>}
</Base>
