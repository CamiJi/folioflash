---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import { t } from '../i18n/ui';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const portfolio = site as unknown as {
  experiences?: Array<{ title: string; role: string; years: string; summary: string }>;
  articles?: Array<{ title: string; publisher: string; year: string; summary: string; url: string }>;
};
const experiences = portfolio.experiences ?? [];
const articles = portfolio.articles ?? [];
const route = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\/+/, '')}`;
---

<Base title={`${t('en', 'about')} — ${site.name}`} description={site.bio} lang="en">
  <article class="grid gap-10 md:grid-cols-[0.6fr_1fr] md:gap-20">
    <div>
      <p class="eyebrow mb-5">{site.craft}</p>
      <h1 class="page-title">{t('en', 'about')}</h1>
    </div>
    <div class="max-w-2xl">
      <p class="font-display text-3xl leading-tight tracking-tight md:text-5xl">{site.tagline}</p>
      <p class="mt-6 text-lg leading-relaxed text-muted">{site.bio}</p>
      {projects.length > 0 && <p class="mt-8 border-t border-rule pt-5 text-sm text-muted">{projects.length} {projects.length === 1 ? 'selected project' : 'selected projects'} in the portfolio.</p>}
      <a class="text-link" href={route('contact/')}>{t('en', 'emailMe')} <span aria-hidden="true">↗</span></a>
    </div>
  </article>
  {experiences.length > 0 && <section class="mt-20 max-w-4xl" aria-labelledby="experience-title">
    <h2 id="experience-title" class="mb-6 font-display text-2xl">Experience</h2>
    <div class="divide-y divide-rule border-y border-rule">
      {experiences.map((item) => <article class="grid gap-2 py-5 sm:grid-cols-[0.7fr_1.3fr] sm:gap-8">
        <div><h3 class="font-display text-xl">{item.title}</h3><p class="text-sm text-muted">{item.role}{item.years ? ` · ${item.years}` : ''}</p></div>
        {item.summary && <p class="max-w-2xl text-muted">{item.summary}</p>}
      </article>)}
    </div>
  </section>}
  {articles.length > 0 && <section class="mt-20 max-w-4xl" aria-labelledby="articles-title">
    <h2 id="articles-title" class="mb-6 font-display text-2xl">Writing &amp; media</h2>
    <ul class="divide-y divide-rule border-y border-rule">
      {articles.map((item) => <li class="py-5">
        {item.url ? <a class="text-link mt-0" href={item.url} rel="noreferrer">{item.title} <span aria-hidden="true">↗</span></a> : <h3 class="font-display text-xl">{item.title}</h3>}
        <p class="mt-1 text-sm text-muted">{[item.publisher, item.year].filter(Boolean).join(' · ')}</p>
        {item.summary && <p class="mt-2 max-w-2xl text-muted">{item.summary}</p>}
      </li>)}
    </ul>
  </section>}
</Base>
