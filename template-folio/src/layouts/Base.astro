---
import '../styles/global.css';
import site from '../data/site.json';
import { t, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
}

const { title, description, lang = 'en' } = Astro.props;
const palette = (site as { palette?: string }).palette ?? 'paper';
const homeHref = lang === 'fr' ? '/fr/' : '/';
const prefix = lang === 'fr' ? '/fr' : '';
---

<!doctype html>
<html lang={lang} data-palette={palette}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header style="border-bottom:1px solid var(--color-rule)">
      <nav
        style="max-width:var(--max-width);margin:0 auto;padding:1rem 1.5rem;display:flex;gap:1.25rem;align-items:center"
      >
        <a href={homeHref} style="font-weight:700;color:var(--color-ink);text-decoration:none">
          {(site as { name: string }).name}
        </a>
        <a href={`${prefix}/work/`}>{t(lang, 'work')}</a>
        <a href={`${prefix}/about/`}>{t(lang, 'about')}</a>
        <a href={`${prefix}/contact/`}>{t(lang, 'contact')}</a>
        <span style="margin-left:auto">
          {lang === 'fr' ? <a href="/">EN</a> : <a href="/fr/">FR</a>}
        </span>
      </nav>
    </header>
    <main style="max-width:var(--max-width);margin:0 auto;padding:3rem 1.5rem">
      <slot />
    </main>
    <footer
      style="border-top:1px solid var(--color-rule);text-align:center;padding:1.5rem;color:var(--color-ink-muted);font-size:0.875rem"
    >
      {t(lang, 'madeWith')} ⚡
    </footer>
  </body>
</html>
