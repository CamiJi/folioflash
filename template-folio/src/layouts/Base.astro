---
import '../styles/global.css';
import site from '../data/site.json';
import { t, type Lang } from '../i18n/ui';
import { buildProfilePageSchema, safeJsonLd, type PersonaSource } from '../lib/persona';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
}

const { title, description, lang = 'en' } = Astro.props;
const palette = (site as { palette?: string }).palette ?? 'paper';
const theme = (site as { theme?: Record<string, string> }).theme;
const themeVars = theme
  ? Object.entries({
      '--color-paper': theme.paper,
      '--color-surface': theme.surface,
      '--color-ink': theme.ink,
      '--color-muted': theme.muted,
      '--color-rule': theme.rule,
      '--color-brand': theme.brand,
      '--color-brand-strong': theme.brandStrong,
      '--art-one': theme.artOne,
      '--art-two': theme.artTwo,
      '--art-three': theme.artThree,
    })
    .filter(([, value]) => typeof value === 'string' && /^#[0-9a-fA-F]{6}$/.test(value))
    .map(([key, value]) => `${key}:${value}`)
    .join(';')
  : undefined;
const base = import.meta.env.BASE_URL;
const route = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
const homeHref = route(lang === 'fr' ? 'fr/' : '');
const prefix = lang === 'fr' ? 'fr/' : '';
const projectCount = (site as unknown as { projectCount?: number }).projectCount;
const persona = site as unknown as PersonaSource;
const canonicalBase = new URL(import.meta.env.BASE_URL, Astro.site ?? 'https://example.com');
const basePath = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const canonicalPath = currentPath.startsWith(basePath) ? currentPath.slice(basePath.length) : currentPath.replace(/^\/+/, '');
const canonicalUrl = new URL(canonicalPath, canonicalBase).toString();
const structuredProfile = buildProfilePageSchema(persona, canonicalUrl);
const jsonLd = safeJsonLd(structuredProfile);
const nav = [
  ...(projectCount === 0 ? [] : [{ label: t(lang, 'work'), href: route(`${prefix}${lang === 'fr' ? 'realisations/' : 'work/'}`) }]),
  { label: t(lang, 'about'), href: route(`${prefix}${lang === 'fr' ? 'a-propos/' : 'about/'}`) },
  { label: t(lang, 'contact'), href: route(`${prefix}contact/`) },
];
---

<!doctype html>
<html lang={lang} data-palette={palette} style={themeVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={theme?.paper ?? (palette === 'iris' ? '#171526' : '#f5f3eb')} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={route('favicon.svg')} />
    <script type="application/ld+json" set:html={jsonLd}></script>
  </head>
  <body class="min-h-screen bg-paper font-sans text-ink antialiased">
    <a class="skip-link" href="#main">{lang === 'fr' ? 'Aller au contenu' : 'Skip to content'}</a>
    <header class="site-header">
      <nav class="site-nav" aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
        <a class="site-wordmark" href={homeHref} aria-label={`${site.name} — home`}>
          <span class="wordmark-dot" aria-hidden="true"></span>{site.name}
        </a>
        <div class="nav-links">
          {nav.map((item) => <a class="nav-link" href={item.href}>{item.label}</a>)}
          <a class="language-link" href={route(lang === 'fr' ? '' : 'fr/')} aria-label={lang === 'fr' ? 'English' : 'Français'}>
            {lang === 'fr' ? 'EN' : 'FR'}
          </a>
        </div>
      </nav>
    </header>
    <main id="main" class="page-shell">
      <slot />
    </main>
    <footer class="site-footer">
      <span>{site.name}</span>
      <a href={homeHref}>{t(lang, 'madeWith')}</a>
    </footer>
  </body>
</html>
