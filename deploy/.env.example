LLM_PROVIDER=openrouter
LLM_API_KEY=replace-with-a-dedicated-key
LLM_MODEL=google/gemini-3.7-flash
# Bounded interviewer + completeness evaluator; account-wide usage includes deleted drafts.
BRIEF_MODEL=google/gemini-3.7-flash
BRIEF_MAX_TURNS=6
BRIEF_MAX_COST_EUR=0.02
BRIEF_MAX_CALL_RESERVE_EUR=0.0015
# Optional one-time free rebrief for internal QA addresses only; keep empty for normal pilots.
BRIEF_TEST_FREE_EMAILS=
# OpenRouter reports cost in USD; this converts its estimate to EUR.
USD_EUR_RATE=0.92
# Use magic after the sender identity and end-to-end login have been verified.
AUTH_MODE=magic
PUBLIC_BASE_URL=https://folioflash.camilleaubert.com
EMAIL_PROVIDER=brevo-smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_LOGIN=your-brevo-smtp-login
SMTP_PASS=replace-with-brevo-smtp-key
MAIL_FROM=Folioflash <sender@your-verified-domain.example>
SESSION_SECRET=replace-with-at-least-32-random-characters
MAGIC_ALLOWED_EMAILS=owner@example.com
PUBLIC_SIGNUP_ENABLED=false
