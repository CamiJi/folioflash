LLM_PROVIDER=openrouter
LLM_API_KEY=replace-with-a-dedicated-key
LLM_MODEL=google/gemini-3.7-flash
# OpenRouter reports cost in USD; this converts its estimate to EUR.
USD_EUR_RATE=0.92
STUDIO_USER=camille
STUDIO_PASSWORD=replace-with-a-long-random-password

# Keep AUTH_MODE=basic until the sender identity is verified and email delivery is tested.
AUTH_MODE=basic
PUBLIC_BASE_URL=https://folioflash.camilleaubert.com
EMAIL_PROVIDER=brevo
BREVO_API_KEY=replace-with-brevo-api-key
MAIL_FROM=Folioflash <sender@your-verified-domain.example>
SESSION_SECRET=replace-with-at-least-32-random-characters
